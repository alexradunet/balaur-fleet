#!@bash@
# balaur-home-agent: pi in its home role, the voice assistant's brain.
# Started by the GJS daemon (gnome/assistant/pi-agent.js), which speaks pi's RPC
# protocol on its stdin and stdout. With --test: one tiny request with the same
# model, exit status 0 when it answered.
#
# Environment (from the session unit and the daemon):
#   BALAUR_PI_MODELS   pi's models.json for the fleet's AI entryway (agent.nix).
#                      Unset: pi's own Mistral provider, with MISTRAL_API_KEY.
#   BALAUR_LLM_MODEL   the model to start with; one the file does not have falls
#                      back to its first.
#   BALAUR_ASSISTANT_CONFIG, MISTRAL_API_KEY, BALAUR_SPEECH_BASE_URL   for the extension
set -eu

# pi keeps a few files of its own beside its configuration: a private directory.
state="${STATE_DIRECTORY:-${XDG_STATE_HOME:-$HOME/.local/state}/balaur-assistant}/pi"
# An empty working directory: nothing for pi to find there.
work="${XDG_RUNTIME_DIR:-/tmp}/balaur-home-agent"
mkdir -p "$state" "$work"
cd "$work"

export PI_CODING_AGENT_DIR="$state" PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0
export BALAUR_BUSCTL="${BALAUR_BUSCTL:-@busctl@}"

model=${BALAUR_LLM_MODEL:-}
if [ -n "${BALAUR_PI_MODELS:-}" ]; then
  ln -sfn "$BALAUR_PI_MODELS" "$state/models.json"
  provider=$(@jq@ -r '.providers | keys[0]' "$BALAUR_PI_MODELS")
  if ! @jq@ -e --arg p "$provider" --arg m "$model" '.providers[$p].models | any(.id == $m)' "$BALAUR_PI_MODELS" > /dev/null; then
    first=$(@jq@ -r --arg p "$provider" '.providers[$p].models[0].id' "$BALAUR_PI_MODELS")
    [ -z "$model" ] || echo "balaur-home-agent: no model '$model' at the entryway; using '$first'" >&2
    model=$first
  fi
else
  rm -f "$state/models.json"
  provider=mistral
  model=${model:-mistral-medium-latest}
fi

# No tools of pi's own, and nothing found on disk: the extension is all there is.
args=(--no-session --no-builtin-tools --no-skills --no-prompt-templates --no-context-files
  --no-themes --no-mcp --provider "$provider" --model "$model")

if [ "${1:-}" = --test ]; then
  exec @pi@ "${args[@]}" --no-extensions --print "Reply with the single word OK." > /dev/null
fi
exec @pi@ --mode rpc "${args[@]}" --extension @share@/index.ts
