<?xml version="1.0" encoding="UTF-8"?>
<!-- "Duet": a Samsung (Tizen) TV app that opens the home-server dashboard in
     TV mode (remote-control navigation). Installed with `duet-tv-sideload dashboard`,
     which also fills in the dashboard address (duet.tv.dashboardUrl).
     Shaped like jellyfin-tizen's manifest, which is known to run on Tizen 6 TVs:
     with viewmodes="maximized" and the "tv-samsung" profile the screen stayed black. -->
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets"
        id="http://duet.local/tv-app" version="1.0.1" viewmodes="fullscreen">
  <access origin="*" subdomains="true"></access>
  <tizen:application id="DuetDashbd.Duet" package="DuetDashbd" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="fullscreen"/>
  <name>Duet</name>
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:profile name="tv"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
